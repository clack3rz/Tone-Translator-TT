{
  "entities": {
    "gear_item": {
      "title": "AT5 Gear Item",
      "description": "A piece of gear in the AmpliTude 5 catalog",
      "type": "object",
      "properties": {
        "group": { "type": "string" },
        "guid": { "type": "string" },
        "slot": { "type": "string" },
        "displayName": { "type": "string" },
        "otherNames": { "type": "array", "items": { "type": "string" } },
        "usedInPresets": { "type": "integer" },
        "paramSuffix": { "type": "string" },
        "knobs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "min": { "type": "number" },
              "max": { "type": "number" },
              "default": { "type": "any" },
              "options": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["group", "guid", "displayName"]
    },
    "verified_mapping": {
      "title": "Verified Protocol Mapping",
      "description": "A mapping between a GUID and its known aliases for Cabs, Speakers, or Mics",
      "type": "object",
      "properties": {
        "guid": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["guid", "aliases"]
    },
    "parameter_mapping": {
      "title": "Gear Parameter Mapping",
      "description": "Definition of visual to export conversion rules for a gear's parameter",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gearName": { "type": "string" },
        "parameter": { "type": "string" },
        "visualMin": { "type": "number" },
        "visualMax": { "type": "number" },
        "visualUnit": { "type": "string" },
        "exportMin": { "type": "number" },
        "exportMax": { "type": "number" },
        "exportParameterName": { "type": "string" },
        "conversion": { "type": "string" },
        "formula": { "type": "string" },
        "gearGuid": { "type": "string" },
        "displayParameterName": { "type": "string" },
        "canonicalParameterName": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "savedAliases": { "type": "array", "items": { "type": "string" } },
        "rawMappingAliases": { "type": "array", "items": { "type": "string" } },
        "autoGeneratedAliases": { "type": "array", "items": { "type": "string" } },
        "effectiveAliases": { "type": "array", "items": { "type": "string" } },
        "at5XmlAttributeName": { "type": "string" },
        "interfaceType": { "type": "string" },
        "parameterKind": { "type": "string" },
        "displayMin": { "type": "number" },
        "displayMax": { "type": "number" },
        "displayUnit": { "type": "string" },
        "displayStep": { "type": "number" },
        "decimalPlaces": { "type": "number" },
        "displayPrecision": { "type": "number" },
        "displayDecimalPlaces": { "type": "number" },
        "defaultDisplayValue": { "type": "string" },
        "exportUnit": { "type": "string" },
        "exportStep": { "type": "number" },
        "exportDecimalPlaces": { "type": "number" },
        "exportPrecision": { "type": "number" },
        "defaultExportValue": { "type": "string" },
        "translationMode": { "type": "string" },
        "valueMap": { "type": "object" },
        "reverseValueMap": { "type": "object" },
        "helperDescription": { "type": "string" },
        "exampleInput": { "type": "string" },
        "exampleOutput": { "type": "string" },
        "validationStatus": { "type": "string" },
        "mappingConfidence": { "type": "string" },
        "source": { "type": "string" },
        "doNotRequestForGear": { "type": "boolean" },
        "unsupportedReason": { "type": "string" },
        "reviewNotes": { "type": "string" },
        "valueMapJson": { "type": "string" },
        "reverseValueMapJson": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["gearName", "parameter", "conversion", "exportParameterName"]
    },
    "mic_placement_mapping": {
      "title": "Mic Placement Mapping",
      "description": "Custom mic placement to XML value mappings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gear": { "type": "string" },
        "friendly_setting": { "type": "string" },
        "target": { "type": "string" },
        "friendly_value": { "type": "string" },
        "friendly_name": { "type": "string" },
        "maps_to": { "type": "object" },
        "xml_values": { "type": "object" },
        "status": { "type": "string" },
        "validation_status": { "type": "string" },
        "source": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" },
        "cabGuid": { "type": "string" },
        "cabName": { "type": "string" },
        "cabAliases": { "type": "array", "items": { "type": "string" } },
        "micSlot": { "type": "string" },
        "micIndex": { "type": "integer" },
        "canonicalPlacementName": { "type": "string" },
        "placementAliases": { "type": "array", "items": { "type": "string" } },
        "friendlyPlacement": { "type": "string" },
        "friendlyDistance": { "type": "string" },
        "micModelName": { "type": "string" },
        "micModelGuid": { "type": "string" },
        "micModelScope": { "type": "string" },
        "validationStatus": { "type": "string" },
        "confidence": { "type": "string" },
        "discoveredFromPresetName": { "type": "string" },
        "discoveredFromFileName": { "type": "string" },
        "discoveredAt": { "type": "string" },
        "notes": { "type": "string" },
        "rawXmlSource": { "type": "string" },
        "isActive": { "type": "boolean" },
        "isDefault": { "type": "boolean" },
        "isDeprecated": { "type": "boolean" },
        "conflictReason": { "type": "string" },
        "lastVerifiedAgainstAt5p": { "type": "string" }
      },
      "required": ["gear", "friendly_setting", "friendly_value", "maps_to"]
    },
    "gear_discovery_candidate": {
      "title": "IKMPAK Gear Discovery Candidate",
      "description": "An unverified gear candidate staged from .pak or JSON/CSV imports",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "importBatchId": { "type": "string" },
        "pakCategory": { "type": "string" },
        "candidateGearType": { "type": "string" },
        "name": { "type": "string" },
        "normalizedName": { "type": "string" },
        "guid": { "type": "string" },
        "shortName": { "type": "string" },
        "shortName2": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "collectionTags": { "type": "array", "items": { "type": "string" } },
        "manufacturerHints": { "type": "string" },
        "realWorldHints": { "type": "string" },
        "matchedGearProfileId": { "type": "string" },
        "discoveryStatus": { "type": "string" },
        "validationStatus": { "type": "string" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["name", "candidateGearType", "guid", "importBatchId"]
    },
    "requested_parameter_review": {
      "title": "Requested Parameter Review",
      "description": "A parameter that was requested but couldn't be fully mapped, flagged for review",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gearName": { "type": "string" },
        "gearGuid": { "type": "string" },
        "requestedParameterName": { "type": "string" },
        "requestedValue": { "type": "any" },
        "normalizedParameterName": { "type": "string" },
        "occurrenceCount": { "type": "integer" },
        "firstSeen": { "type": "string", "format": "date-time" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "sourceToneRequest": { "type": "string" },
        "suggestedMatches": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["CHECK", "ADD_MAPPING", "MAP_TO_EXISTING", "MARK_UNSUPPORTED", "IGNORE_ONCE", "DO_NOT_REQUEST"] },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["gearName", "requestedParameterName", "occurrenceCount", "firstSeen", "lastSeen", "status"]
    },
    "system_calibration": {
      "title": "System Calibration",
      "description": "System-wide VIR reference calibration coordinate overrides",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "positions": { "type": "object" },
        "distances": { "type": "object" },
        "angles": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "positions", "distances", "angles"]
    }
  },
  "firestore": {
    "/catalogue/{guid}": {
      "schema": "gear_item",
      "description": "Main gear catalogue"
    },
    "/verified_cabs/{guid}": {
      "schema": "verified_mapping",
      "description": "Verified Cabinet GUID mappings"
    },
    "/verified_speakers/{guid}": {
      "schema": "verified_mapping",
      "description": "Verified Speaker GUID mappings"
    },
    "/verified_mics/{guid}": {
      "schema": "verified_mapping",
      "description": "Verified Microphone GUID mappings"
    },
    "/parameter_mappings/{mappingId}": {
      "schema": "parameter_mapping",
      "description": "A mapping for a gear parameter conversion rule"
    },
    "/mic_placement_mappings/{mappingId}": {
      "schema": "mic_placement_mapping",
      "description": "Custom mic placement mappings to XML attributes"
    },
    "/gear_discovery_candidates/{candidateId}": {
      "schema": "gear_discovery_candidate",
      "description": "Staged unverified gear candidates"
    },
    "/requested_parameter_reviews/{reviewId}": {
      "schema": "requested_parameter_review",
      "description": "Reviews of requested parameters that were not found/mapped"
    },
    "/system_calibrations/{calibrationId}": {
      "schema": "system_calibration",
      "description": "System-wide calibration overrides"
    }
  }
}
